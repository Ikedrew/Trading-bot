# Discord V2 Bot Token
# Create at: https://discord.com/developers/applications
# Required permissions: Send Messages, Embed Links
DISCORD_BOT_TOKEN=

# AWS credentials (if not using IAM role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-2

# Research Engine S3 access (read-only research reads ONLY)
# Local development: point the Research Engine S3 data source at the SSO profile
# that owns trading-bot-v10-data (account 179512357189). This works WITHOUT the
# user manually setting AWS_PROFILE and does not affect collectors/writers.
# Example local value (canonical SSO profile): RESEARCH_AWS_PROFILE=trading-bot-new
# Leave empty on EC2/VM - the trading bot's instance role is used automatically.
RESEARCH_AWS_PROFILE=

# Isolated MT5 account diagnostics: python -m core.accounts
# Keep each account logged into its OWN terminal installation/data directory.
# These settings do NOT alter main.py or enable account fan-out trading.
# Diagnostics attach only to already running terminals and verify login/server;
# they never read passwords, call login(), select symbols, or submit orders.
# Password variables are reserved for a future explicit isolated connection flow;
# use MT5's saved credentials for phase 1. Never commit populated secrets.
MT5_METAQUOTES_ENABLED=true
MT5_METAQUOTES_ROLE=baseline
MT5_METAQUOTES_LOGIN=
MT5_METAQUOTES_SERVER=
MT5_METAQUOTES_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_METAQUOTES_TERMINAL_DATA_PATH=
MT5_METAQUOTES_PORTABLE=false
MT5_METAQUOTES_PASSWORD=
MT5_METAQUOTES_SYMBOL_MAP={}

MT5_ADMIRALS_ENABLED=false
MT5_ADMIRALS_ROLE=observe_only
MT5_ADMIRALS_LOGIN=
MT5_ADMIRALS_SERVER=
MT5_ADMIRALS_TERMINAL_PATH=
MT5_ADMIRALS_TERMINAL_DATA_PATH=
MT5_ADMIRALS_PORTABLE=false
MT5_ADMIRALS_PASSWORD=
MT5_ADMIRALS_SYMBOL_MAP={}

MT5_VANTAGE_ENABLED=false
MT5_VANTAGE_ROLE=observe_only
MT5_VANTAGE_LOGIN=
MT5_VANTAGE_SERVER=
MT5_VANTAGE_TERMINAL_PATH=
MT5_VANTAGE_TERMINAL_DATA_PATH=
MT5_VANTAGE_PORTABLE=false
MT5_VANTAGE_PASSWORD=
MT5_VANTAGE_SYMBOL_MAP={}
# SYMBOL_MAP is an explicit JSON canonical -> exact broker symbol map, e.g.
# {"NAS100":"confirmed broker name"}. Ambiguous matches are never guessed.
MT5_METAQUOTES_UNSUPPORTED_SYMBOLS=[]
MT5_ADMIRALS_UNSUPPORTED_SYMBOLS=["NAS100", "US500", "XAUUSD"]
MT5_VANTAGE_UNSUPPORTED_SYMBOLS=[]

# Terminal manager (opt-in). When true, startup ensures/launches each enabled
# account's dedicated MT5 terminal at most once (portable accounts get
# /portable and /config:<data dir>\config\bootstrap.ini), verifies
# terminal/account readiness fail-closed, keeps terminals out of the
# desktop/taskbar (restore any account with TerminalManager.show), and never
# terminates a foreign terminal or a duplicated/ambiguous one.
# MT5_TERMINAL_MANAGER_ENABLED=true
