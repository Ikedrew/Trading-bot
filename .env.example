# Discord V2 Bot Token
# Create at: https://discord.com/developers/applications
# Required permissions: Send Messages, Embed Links
DISCORD_BOT_TOKEN=

# AWS credentials (if not using IAM role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-2

# Research Engine S3 access (read-only research reads ONLY)
# Local development: point the Research Engine S3 data source at the SSO profile
# that owns trading-bot-v10-data (account 179512357189). This works WITHOUT the
# user manually setting AWS_PROFILE and does not affect collectors/writers.
# Example local value (canonical SSO profile): RESEARCH_AWS_PROFILE=trading-bot-new
# Leave empty on EC2/VM - the trading bot's instance role is used automatically.
RESEARCH_AWS_PROFILE=
