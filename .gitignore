# Runtime data
runtime/

# Scoped exception: NEW Shadow live-path integration sources.
# core/runtime/ is source code collaterally caught by the generic
# runtime/ rule; root runtime/ remains ignored as generated local state.
!core/runtime/
# core/runtime/*
!core/runtime/__init__.py
!core/runtime/live_scanner.py
!core/runtime/bar_provider.py

data/*.jsonl

# Python cache
__pycache__/
*.pyc

# Test artifacts
MagicMock/

# Local environment
.env
.venv/

# Logs
*.log

# ---------------------------------------------------------------------------
# V1 production-data epoch reset — generated/runtime data hygiene
# These paths hold generated runtime datasets (re-created by the bot at
# runtime). They are ignored so fresh production data does not appear as Git
# changes. Intentional source/docs are preserved via negation rules below.
# ---------------------------------------------------------------------------

# Event stream (generated)
events/

# Replay tick data (generated)
replay_data/

# Temporary S3 shadow output (generated)
tmp_s3_shadows/

# Generated research projections + reports (keep hand-authored architecture docs)
research_data/*
!research_data/README.md
reports/research/
reports/research_cycles/

# Generated runtime datasets under logs/ (keep the source module + heartbeat temp files)
logs/*
!logs/opportunity_assessment_log.py

# Generated temporary heartbeat/state files
*.tmp
